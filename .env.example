# Supabase (server only; the service role key never reaches the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# n8n webhook that pushes the lead into the CRM and sends the SMS/email acknowledgement
N8N_LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header so n8n can reject anything else
N8N_WEBHOOK_SECRET=

# Public site URL, used for canonical and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://mxddigital.com.au
