# n8n webhook (production /webhook/ URL) that pushes the lead into the CRM and sends the SMS/email acknowledgement
N8N_LEAD_WEBHOOK_URL=
# Optional shared secret, sent as the X-Webhook-Secret header so n8n can reject anything else
N8N_WEBHOOK_SECRET=

# Optional. Defaults to https://mxddigital.com; override for staging/preview domains.
# NEXT_PUBLIC_SITE_URL=https://mxddigital.com
